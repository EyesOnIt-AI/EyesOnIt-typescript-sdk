{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts"
  ],
  "entryPointStrategy": "resolve",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "readme": "none",
  "out": "generated/docs/sdk-api",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "excludeNotDocumented": false,
  "disableSources": true,
  "sort": [
    "source-order"
  ]
}
